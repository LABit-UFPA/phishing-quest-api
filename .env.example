# Copie para .env e ajuste os valores. Nenhum destes valores e real.
# postgres/connector.go usa defaults se as variaveis de DB nao existirem,
# mas os defaults NAO batem com as credenciais do docker-compose.yml.

# --- Banco de dados ---
DB_HOST=localhost
DB_USER=labsc
DB_PASSWORD=phishingquest
DB_NAME=phishing_quest
DB_PORT=5432
DB_SSLMODE=disable
DB_TIMEZONE=UTC
DB_CONNECT_TIMEOUT=5

# --- Autenticacao (JWT) ---
# Obrigatorio: sem JWT_SECRET o servico sobe com um segredo de
# desenvolvimento inseguro (ver core/service/jwt_service.go). Gere um
# valor aleatorio forte para qualquer ambiente que nao seja a sua
# maquina local, ex.: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio
# Formato aceito pelo time.ParseDuration do Go (ex.: 24h, 30m, 15m)
JWT_EXPIRES_IN=24h

# --- CORS ---
# Lista separada por virgula das origens permitidas. Sem esta
# variavel o CORS libera qualquer origem (adequado so para dev local).
# Ex.: CORS_ALLOWED_ORIGINS=https://phishingquest.labsc.com.br,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# --- Export de pesquisa ---
# Obrigatorio para o export de dados de pesquisa (GET /research/export)
# produzir hashes estaveis e nao-correlacionaveis sem o salt. Gere um
# valor aleatorio forte, ex.: openssl rand -hex 32. Trocar o salt
# invalida a correlacao entre exports anteriores e novos (mesmo
# usuario passa a gerar um pseudo-id diferente).
RESEARCH_EXPORT_SALT=troque-por-um-salt-forte-e-aleatorio

# --- Selecao adaptativa por pista (GET /items/next?mode=adaptive) ---
# Parametros de "dominio de pista" (mastery). Os defaults valem para o
# piloto e devem ser recalibrados com dados reais antes do estudo
# principal. Valores invalidos sao ignorados (cai no default).
# Acuracia a partir da qual a pista e considerada dominada (0 < v <= 1).
ADAPTIVE_MASTERY_THRESHOLD=0.75
# Minimo de respostas com a pista antes de julgar dominio (evita
# reagir a ruido: errar 1 de 1 nao caracteriza dificuldade sistematica).
ADAPTIVE_MASTERY_MIN_EXPOSURES=3
# Quantas pistas fracas entram no foco de uma vez (limitar mantem o
# efeito adaptativo quando o usuario vai mal em quase tudo).
ADAPTIVE_MASTERY_MAX_WEAK_CUES=3
