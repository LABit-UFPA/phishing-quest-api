# Config de referencia para rodar o Flyway manualmente contra o banco
# de producao (RDS). Nao e consumido por nenhum workflow automatizado
# hoje: o deploy via Kubernetes (kubernetes/prod/flyway-migration-job.yaml)
# usa "filesystem:/flyway/sql" montado por ConfigMap, nao este arquivo.
#
# flyway.locations apontava para "migrate/br/changelogs", diretorio que
# nunca existiu neste repositorio (as migrations sempre estiveram em
# migrate/changelogs) — rodar flyway com este config aplicaria zero
# migrations silenciosamente.
flyway.url=jdbc:postgresql://phishing_quest-db.cm90sapdvq98.sa-east-1.rds.amazonaws.com:5432/phishing_quest
flyway.user=@DB_USERNAME
flyway.password=@DB_PASSWORD
flyway.schemas=phishing_quest
flyway.locations=filesystem:migrate/changelogs